# 서버에서는 이 파일을 .env 로 복사해 실제 값을 채운다. chmod 600 을 잊지 말 것.

# compose 안에서는 호스트가 localhost 가 아니라 서비스명 postgres 다.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/biz_lantern

# 필수 - 없으면 앱이 뜨지 않는다
DART_API_KEY=
NTS_API_KEY=

# 선택 - 없으면 해당 기능만 저하 동작한다
KIPRIS_API_KEY=
TAVILY_API_KEY=

# 뉴스 요약/보고서 서술용 LLM (OpenAI 호환 게이트웨이)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 브라우저가 API 를 부를 수 있는 출처. 쉼표로 구분한다.
# nginx 가 /api 를 프록시하는 기본 구성에서는 동일 출처라 실제로 쓰이지 않는다.
CORS_ORIGINS=http://localhost:5173
